<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Ember third-party Rust licenses</title>
  <style>
    body { font: 1rem/1.4 sans-serif; margin: 2rem auto; max-width: 70rem; padding: 0 1rem; }
    pre { border: 1px solid #aaa; overflow: auto; padding: 1rem; white-space: pre-wrap; }
  </style>
</head>
<body>
  <h1>Ember third-party Rust licenses</h1>
  <p>Generated from Ember's locked Cargo dependency graph. This report includes build and test dependencies and all shipped target platforms. Ember's own license and the original Pyrrhic notice are supplied separately.</p>
  {{#each licenses}}
  <section>
    <h2>{{name}}</h2>
    <p>Used by:</p>
    <ul>
      {{#each used_by}}
      <li>{{crate.name}} {{crate.version}}</li>
      {{/each}}
    </ul>
    <pre>{{text}}</pre>
  </section>
  {{/each}}
</body>
</html>
